#!/usr/bin/env bash
set -euo pipefail
umask 077

source "{{ backup_script_dir }}/lib.sh"

BACKUP_DIR="{{ backups_dir }}/mealie"
KEEP_DAYS=7
MEALIE_DIR="{{ mealie_dir }}"
MEALIE_PORT="{{ mealie_port }}"

require_mounted {{ data_dir }}

echo "▶️ Starting mealie backup..."
DEST="$(make_dest "$BACKUP_DIR" mealie-data tar.gz)"

# consistent snapshot of /app/data: stop -> tar -> start
ensure_mealie_up() {
  docker compose -f "$MEALIE_DIR/compose.yaml" start mealie >/dev/null

  # wait until mealie answers again
  for _ in {1..60}; do
    curl -sf "http://localhost:$MEALIE_PORT/" >/dev/null && return 0
    sleep 1
  done
  echo "❌ ERROR: mealie did not become healthy after restart"
  exit 1
}

# restore on any exit - never leave mealie down
trap ensure_mealie_up EXIT

docker compose -f "$MEALIE_DIR/compose.yaml" stop mealie >/dev/null
tar -czf "$DEST" -C "$MEALIE_DIR" data

verify_archive "$DEST" tar -tzf
finish_backup "$BACKUP_DIR" 'mealie-data-*.tar.gz' "$KEEP_DAYS" "$DEST"
