#!/usr/bin/env bash
set -euo pipefail
umask 077

source "{{ backup_script_dir }}/lib.sh"

require_mounted {{ data_dir }}

echo "▶️ Starting cloud backup sync..."

failed=0
for remote in gcrypt kcrypt; do
  if ! rclone sync {{ backups_dir }} "$remote:"; then
    echo "❌ ERROR: sync to $remote failed"
    failed=1
  fi
done

if [ "$failed" -ne 0 ]; then
  echo "❌ ERROR: cloud sync failed"
  exit 1
fi

echo "✅ OK: backups synced to Google Drive and Koofr"
