#!/usr/bin/env bash
set -euo pipefail
umask 077

source "{{ backup_script_dir }}/lib.sh"

require_mounted {{ data_dir }}

echo "▶️ Starting cloud backup sync..."
if ! rclone sync /mnt/data/backups gcrypt:rpi4-backups; then
  echo "❌ ERROR: cloud sync failed"
  exit 1
fi

echo "✅ OK: backups synced to Google Drive"
