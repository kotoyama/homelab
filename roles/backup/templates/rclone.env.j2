RCLONE_CONFIG=/dev/null

RCLONE_CONFIG_GDRIVE_TYPE='drive'
RCLONE_CONFIG_GDRIVE_SCOPE='drive.file'
RCLONE_CONFIG_GDRIVE_CLIENT_ID='{{ vault_rclone_gdrive_client_id }}'
RCLONE_CONFIG_GDRIVE_CLIENT_SECRET='{{ vault_rclone_gdrive_client_secret }}'
RCLONE_CONFIG_GDRIVE_TOKEN='{{ vault_rclone_gdrive_token }}'

RCLONE_CONFIG_GCRYPT_TYPE='crypt'
RCLONE_CONFIG_GCRYPT_REMOTE='gdrive:{{ backup_cloud_dir }}'

RCLONE_CONFIG_KOOFR_TYPE='koofr'
RCLONE_CONFIG_KOOFR_USER='{{ vault_rclone_koofr_user }}'
RCLONE_CONFIG_KOOFR_PASSWORD='{{ vault_rclone_koofr_app_password }}'

RCLONE_CONFIG_KCRYPT_TYPE='crypt'
RCLONE_CONFIG_KCRYPT_REMOTE='koofr:{{ backup_cloud_dir }}'

RCLONE_CRYPT_PASSWORD='{{ vault_rclone_crypt_password }}'
RCLONE_CRYPT_PASSWORD2='{{ vault_rclone_crypt_password2 }}'
