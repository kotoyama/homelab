#!/usr/bin/env bash
set -euo pipefail
umask 077

source "{{ backup_script_dir }}/lib.sh"

BACKUP_DIR="{{ backups_dir }}/pihole"
KEEP_DAYS={{ backup_keep_days }}
CLI_PW_FILE="/etc/pihole/cli_pw"

require_mounted {{ data_dir }}

if [ ! -r "$CLI_PW_FILE" ]; then
  echo "❌ ERROR: $CLI_PW_FILE not found (check cli_pw=true in pihole.toml)"
  exit 1
fi

echo "▶️ Starting pihole backup..."
DEST="$(make_dest "$BACKUP_DIR" pihole-teleporter zip)"

# auth: SID + CSRF token (docs.pi-hole.net/api/auth)
PW="$(cat "$CLI_PW_FILE")"
AUTH="$(printf '{"password":"%s"}' "$PW" | curl -s --max-time 30 -X POST http://localhost/api/auth \
  -H "Content-Type: application/json" \
  -d @-)" || {
  echo "❌ ERROR: auth request failed"
  exit 1
}
mapfile -t SESSION < <(echo "$AUTH" | python3 -c '
import sys, json
s = json.load(sys.stdin)["session"]
print(s["sid"])
print(s["csrf"])
' 2>/dev/null)

if [ -z "${SESSION[1]:-}" ]; then
  echo "❌ ERROR: auth failed (cli_pw invalid?)"
  exit 1
fi

SID="${SESSION[0]}"
CSRF="${SESSION[1]}"

# download the export (zip)
if ! curl -s --max-time 120 -H "X-FTL-SID: $SID" -H "X-FTL-CSRF: $CSRF" http://localhost/api/teleporter -o "$DEST"; then
  echo "❌ ERROR: teleporter download failed"
  exit 1
fi

verify_archive "$DEST" unzip -tq
finish_backup "$BACKUP_DIR" 'pihole-teleporter-*.zip' "$KEEP_DAYS" "$DEST"
