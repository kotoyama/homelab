#!/usr/bin/env bash
set -euo pipefail
umask 077

source "{{ backup_script_dir }}/lib.sh"

BACKUP_DIR="{{ backups_dir }}/{{ item.name }}"
KEEP_DAYS={{ backup_keep_days }}
COMPOSE_DIR="{{ item.dir }}"
PORT="{{ item.port }}"
HEALTH_PATH="{{ item.health_path }}"
CONTAINERS=({% for container in item.containers %}{{ container }} {% endfor %})

require_mounted {{ data_dir }}

echo "▶️ Starting {{ item.name }} backup..."
DEST="$(make_dest "$BACKUP_DIR" {{ item.name }}-data tar.gz)"

# wait until the service answers again
wait_healthy() {
  for _ in {1..60}; do
    curl -sf "http://localhost:$PORT$HEALTH_PATH" >/dev/null && return 0
    sleep 1
  done
  echo "❌ ERROR: {{ item.name }} did not become healthy after restart"
  exit 1
}

# restore on any exit - never leave the service down
ensure_service_up() {
  local container
  for container in "${CONTAINERS[@]}"; do
    docker compose -f "$COMPOSE_DIR/compose.yaml" start "$container" >/dev/null
    wait_healthy
  done
}
trap ensure_service_up EXIT

# consistent snapshot of the data dir: stop -> tar -> start
# stop in reverse dependency order (dependents first)
{% for container in item.containers | reverse -%}
  docker compose -f "$COMPOSE_DIR/compose.yaml" stop "{{ container }}" >/dev/null
{% endfor -%}
tar -czf "$DEST" -C "$COMPOSE_DIR" data

verify_archive "$DEST" tar -tzf
finish_backup "$BACKUP_DIR" '{{ item.name }}-data-*.tar.gz' "$KEEP_DAYS" "$DEST"
