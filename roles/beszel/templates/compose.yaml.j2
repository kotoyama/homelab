services:
  beszel:
    image: {{ beszel_image }}
    container_name: beszel
    ports:
      - "{{ beszel_port }}:8090"
    environment:
      - APP_URL=http://{{ server_hostname }}:{{ beszel_port }}
    volumes:
      - ./beszel_data:/beszel_data
      - ./beszel_socket:/beszel_socket
    restart: unless-stopped
{% if beszel_agent_key %}
  beszel-agent:
    image: {{ beszel_agent_image }}
    container_name: beszel-agent
    network_mode: host
    devices:
      - /dev/sda:/dev/sda
    cap_add:
      - SYS_RAWIO
      - SYS_ADMIN
    volumes:
      - ./beszel_agent_data:/var/lib/beszel-agent
      - ./beszel_socket:/beszel_socket
      - {{ data_dir }}/apps:/extra-filesystems/data:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /var/log:/extra-filesystems/sdcard:ro
    environment:
      - LISTEN=/beszel_socket/beszel.sock
      - KEY={{ beszel_agent_key }}
    restart: unless-stopped
{% endif %}
