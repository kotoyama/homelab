services:
  forgejo:
    image: {{ forgejo_image }}
    container_name: forgejo
    ports:
      - "{{ forgejo_port }}:3000"
      - "{{ forgejo_ssh_port }}:22"
    deploy:
      resources:
        limits:
          memory: 1000M
    environment:
      - TZ={{ timezone }}
      - USER_UID=1000
      - USER_GID=1000
      - FORGEJO__server__DOMAIN={{ server_hostname }}
      - FORGEJO__server__ROOT_URL=http://{{ server_hostname }}:{{ forgejo_port }}/
      - FORGEJO__server__SSH_PORT={{ forgejo_ssh_port }}
      - FORGEJO__service__DISABLE_REGISTRATION=true
      - FORGEJO__mirror__DEFAULT_INTERVAL=24h
    volumes:
      - ./data:/data
      - /etc/localtime:/etc/localtime:ro
    restart: unless-stopped
